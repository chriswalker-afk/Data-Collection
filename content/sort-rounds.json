    {
      "id": "compare-quota-stratified",
      "type": "comparison",
      "categories": [
        "stratified",
        "quota"
      ],
      "cards": [
        {
          "prompt": "Select a random sample from a separate register within every population group.",
          "answer": "stratified",
          "why": "Selection within each stratum is random."
        },
        {
          "prompt": "Stop recruiting available people in a category once its target number is reached.",
          "answer": "quota",
          "why": "Non-random recruitment continues until each quota is filled."
        },
        {
          "prompt": "Requires randomly selecting actual individuals after deciding the size of each stratum.",
          "answer": "stratified",
          "why": "Group allocation alone is not enough: within-group selection must be random."
        },
        {
          "prompt": "Can recruit respondents directly without a complete population-wide sampling frame.",
          "answer": "quota",
          "why": "Quota sampling is not based on drawing names from a frame."
        }
      ]
    },
    {
      "id": "compare-simple-systematic",
      "type": "comparison",
      "categories": [
        "simple-random",
        "systematic"
      ],
      "cards": [
        {
          "prompt": "Each possible group of the required sample size has the same chance.",
          "answer": "simple-random",
          "why": "This is the defining condition for a simple random sample."
        },
        {
          "prompt": "After a random start, select every kth member of an ordered list.",
          "answer": "systematic",
          "why": "Regular intervals characterise systematic sampling."
        },
        {
          "prompt": "Choose distinct random integers corresponding to people on a frame.",
          "answer": "simple-random",
          "why": "Selections are random draws, not a regular interval."
        },
        {
          "prompt": "An ordering that repeats in a cycle can affect who is selected.",
          "answer": "systematic",
          "why": "A periodic order can interact with the fixed interval."
        }
      ]
    }
  ]
